# ================================
# Amr Academy – Environment Variables
# ================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase (Public – safe for browser) ──────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ── Supabase (Private – server only) ─────────────────────────────────────────
# Found in: Supabase Dashboard → Project Settings → API → service_role key
# NEVER expose this to the browser. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Application ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Amr Academy"

# ── Cron Security ────────────────────────────────────────────────────────────
# A long random secret used to authenticate cron webhook calls
# Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret-here

# ── Local Supabase (used when running 'supabase start') ───────────────────────
# These are auto-populated by supabase start – leave blank for cloud.
# SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Optional: Timezone ────────────────────────────────────────────────────────
# Used for display formatting; business logic always uses DB server time (now())
TZ=Africa/Cairo
